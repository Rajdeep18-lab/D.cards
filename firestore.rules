rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check strict ownership across possible ownership field aliases (userId, uid, user_id).
    // Requires at least one ownership field to be present, and EVERY present ownership field MUST match authUid.
    // If multiple exist (e.g. both userId and uid), both must strictly match. Conflicting ownership is blocked.
    function isStrictOwner(data, authUid) {
      return (('userId' in data && data.userId == authUid) || 
              ('uid' in data && data.uid == authUid) || 
              ('user_id' in data && data.user_id == authUid)) &&
             (!('userId' in data) || data.userId == authUid) &&
             (!('uid' in data) || data.uid == authUid) &&
             (!('user_id' in data) || data.user_id == authUid);
    }
    
    // Helper function to check if an active admin record exists for the given UID
    function hasActiveAdminDoc(uid) {
      return (exists(/databases/$(database)/documents/admins/$(uid)) && 
              get(/databases/$(database)/documents/admins/$(uid)).data.role == 'admin' &&
              get(/databases/$(database)/documents/admins/$(uid)).data.active == true) ||
             (exists(/databases/$(database)/documents/admin_users/$(uid)) && 
              get(/databases/$(database)/documents/admin_users/$(uid)).data.role == 'admin' &&
              get(/databases/$(database)/documents/admin_users/$(uid)).data.active == true);
    }

    // Helper function to check if user is an admin
    // Strictly requires an active admin document with role: 'admin' AND active: true.
    // Inactive, missing, or invalid admin records strictly cannot grant admin privileges.
    // If authenticated via primary admin email, also strictly requires email_verified == true.
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == null || 
         request.auth.token.email.lower() != 'ritikanshu072@gmail.com' || 
         request.auth.token.email_verified == true) &&
        hasActiveAdminDoc(request.auth.uid);
    }

    // Debit Cards Collection (Public Read, Admin Write Only)
    match /debit_cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Savings Accounts Collections (Public Read, Admin Write Only)
    match /savings_accounts/{accId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /savingsAccounts/{accId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Current Accounts Collections (Public Read, Admin Write Only)
    match /current_accounts/{accId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /currentAccounts/{accId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Account to Debit Card Mappings (Public Read, Admin Write Only)
    match /account_card_mappings/{mapId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banks Collection (Public Read, Admin Write Only)
    match /banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bank Branches & ATMs Collection (Public Read, Admin Write Only)
    match /bank_branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQ Collection (Public Read, Admin Write Only)
    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers Collection (Public Read, Admin Write Only)
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles Collection
    // - On create: user cannot inject privileged fields (role, admin, permissions)
    // - On update: protected fields and ownership identifiers cannot be modified by user or admin
    // - Ordinary profile fields (name, phone, avatar, city, etc.) remain freely editable
    match /profiles/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && 
        (!('id' in request.resource.data) || request.resource.data.id == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('user_id' in request.resource.data) || request.resource.data.user_id == userId) &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'admin', 'permissions', 'is_admin'])) || isAdmin();
      allow update: if (
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'id', 'user_id'])) || (
          isOwner(userId) &&
          (!('id' in request.resource.data) || request.resource.data.id == userId) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
          (!('user_id' in request.resource.data) || request.resource.data.user_id == userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'admin', 'permissions', 'is_admin', 'uid', 'id', 'user_id'])
        )
      );
    }

    // Users Collection (Synchronized Auth Metadata)
    match /users/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && 
        (!('id' in request.resource.data) || request.resource.data.id == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('user_id' in request.resource.data) || request.resource.data.user_id == userId) &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'admin', 'permissions', 'is_admin'])) || isAdmin();
      allow update: if (
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'id', 'user_id'])) || (
          isOwner(userId) &&
          (!('id' in request.resource.data) || request.resource.data.id == userId) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
          (!('user_id' in request.resource.data) || request.resource.data.user_id == userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'admin', 'permissions', 'is_admin', 'uid', 'id', 'user_id'])
        )
      );
    }

    // Contact Queries & Messages Collection (Public Create with Strict Validation, Admin Read/Manage Only)
    match /contact_queries/{queryId} {
      allow create: if request.resource.data.keys().hasOnly([
        'query_id', 'name', 'email', 'phone', 'mobile', 'subject',
        'message', 'createdAt', 'created_at', 'status', 'assigned_to',
        'admin_reply', 'replied_at', 'history'
      ]) &&
      request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 &&
      request.resource.data.email is string && request.resource.data.email.size() <= 150 &&
      request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000 &&
      (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 150)) &&
      (!('mobile' in request.resource.data) || (request.resource.data.mobile is string && request.resource.data.mobile.size() <= 30)) &&
      (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
      (!('query_id' in request.resource.data) || (request.resource.data.query_id is string && request.resource.data.query_id.size() <= 100)) &&
      (!('status' in request.resource.data) || request.resource.data.status == 'Pending') &&
      (!('assigned_to' in request.resource.data) || request.resource.data.assigned_to == 'Founder / Support Team') &&
      (!('admin_reply' in request.resource.data) || request.resource.data.admin_reply == '') &&
      (!('replied_at' in request.resource.data) || request.resource.data.replied_at == null) &&
      ('created_at' in request.resource.data || 'createdAt' in request.resource.data) &&
      (!('created_at' in request.resource.data) || (request.resource.data.created_at is string && request.resource.data.created_at.size() >= 19 && request.resource.data.created_at.size() <= 35)) &&
      (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() >= 19 && request.resource.data.createdAt.size() <= 35) || request.resource.data.createdAt == request.time) &&
      (!('history' in request.resource.data) || (
        request.resource.data.history is list &&
        request.resource.data.history.size() <= 1 &&
        (
          request.resource.data.history.size() == 0 ||
          (
            request.resource.data.history[0] is map &&
            request.resource.data.history[0].keys().hasOnly(['id', 'sender', 'senderName', 'message', 'timestamp']) &&
            request.resource.data.history[0].sender == 'user' &&
            request.resource.data.history[0].senderName is string && request.resource.data.history[0].senderName.size() <= 100 &&
            request.resource.data.history[0].message is string && request.resource.data.history[0].message.size() <= 2000 &&
            (!('id' in request.resource.data.history[0]) || (request.resource.data.history[0].id is string && request.resource.data.history[0].id.size() <= 100)) &&
            (!('timestamp' in request.resource.data.history[0]) || (request.resource.data.history[0].timestamp is string && request.resource.data.history[0].timestamp.size() <= 50))
          )
        )
      ));
      allow read, update, delete: if isAdmin();
    }
    match /contact_messages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly([
        'query_id', 'name', 'email', 'phone', 'mobile', 'subject',
        'message', 'createdAt', 'created_at', 'status', 'assigned_to',
        'admin_reply', 'replied_at', 'history'
      ]) &&
      request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 &&
      request.resource.data.email is string && request.resource.data.email.size() <= 150 &&
      request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000 &&
      (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 150)) &&
      (!('mobile' in request.resource.data) || (request.resource.data.mobile is string && request.resource.data.mobile.size() <= 30)) &&
      (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
      (!('query_id' in request.resource.data) || (request.resource.data.query_id is string && request.resource.data.query_id.size() <= 100)) &&
      (!('status' in request.resource.data) || request.resource.data.status == 'Pending') &&
      (!('assigned_to' in request.resource.data) || request.resource.data.assigned_to == 'Founder / Support Team') &&
      (!('admin_reply' in request.resource.data) || request.resource.data.admin_reply == '') &&
      (!('replied_at' in request.resource.data) || request.resource.data.replied_at == null) &&
      ('created_at' in request.resource.data || 'createdAt' in request.resource.data) &&
      (!('created_at' in request.resource.data) || (request.resource.data.created_at is string && request.resource.data.created_at.size() >= 19 && request.resource.data.created_at.size() <= 35)) &&
      (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() >= 19 && request.resource.data.createdAt.size() <= 35) || request.resource.data.createdAt == request.time) &&
      (!('history' in request.resource.data) || (
        request.resource.data.history is list &&
        request.resource.data.history.size() <= 1 &&
        (
          request.resource.data.history.size() == 0 ||
          (
            request.resource.data.history[0] is map &&
            request.resource.data.history[0].keys().hasOnly(['id', 'sender', 'senderName', 'message', 'timestamp']) &&
            request.resource.data.history[0].sender == 'user' &&
            request.resource.data.history[0].senderName is string && request.resource.data.history[0].senderName.size() <= 100 &&
            request.resource.data.history[0].message is string && request.resource.data.history[0].message.size() <= 2000 &&
            (!('id' in request.resource.data.history[0]) || (request.resource.data.history[0].id is string && request.resource.data.history[0].id.size() <= 100)) &&
            (!('timestamp' in request.resource.data.history[0]) || (request.resource.data.history[0].timestamp is string && request.resource.data.history[0].timestamp.size() <= 50))
          )
        )
      ));
      allow read, update, delete: if isAdmin();
    }

    // Reviews Collection (Public Create with Schema Validation, Admin Read/Manage Only)
    match /reviews/{reviewId} {
      allow create: if request.resource.data.keys().hasOnly([
        'userId', 'userName', 'userEmail', 'rating', 'message', 'category',
        'role', 'cardName', 'createdAt', 'date', 'isUserSubmitted'
      ]) &&
      request.resource.data.userName is string && request.resource.data.userName.size() >= 2 && request.resource.data.userName.size() <= 100 &&
      request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000 &&
      request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
      request.resource.data.createdAt == request.time &&
      (!('userId' in request.resource.data) || request.resource.data.userId == null || (isAuthenticated() && request.resource.data.userId == request.auth.uid)) &&
      (!('userEmail' in request.resource.data) || request.resource.data.userEmail == null ||
        (!isAuthenticated() && request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 150) ||
        (isAuthenticated() && request.resource.data.userEmail == request.auth.token.email)) &&
      (!('category' in request.resource.data) || request.resource.data.category == null || (request.resource.data.category is string && request.resource.data.category.size() <= 100)) &&
      (!('role' in request.resource.data) || request.resource.data.role == null || (request.resource.data.role is string && request.resource.data.role.size() <= 100)) &&
      (!('cardName' in request.resource.data) || request.resource.data.cardName == null || (request.resource.data.cardName is string && request.resource.data.cardName.size() <= 100)) &&
      (!('date' in request.resource.data) || request.resource.data.date == null || (request.resource.data.date is string && request.resource.data.date.size() <= 50)) &&
      (!('isUserSubmitted' in request.resource.data) || request.resource.data.isUserSubmitted is bool);
      allow read, update, delete: if isAdmin();
    }

    // Saved Cards (Strict Ownership with Multi-Field Consistency Check)
    match /saved_cards/{savedId} {
      allow read, delete: if isAuthenticated() && (isStrictOwner(resource.data, request.auth.uid) || isAdmin());
      allow create: if isAuthenticated() && isStrictOwner(request.resource.data, request.auth.uid);
      allow update: if (isAdmin() || (
        isAuthenticated() &&
        isStrictOwner(resource.data, request.auth.uid) &&
        isStrictOwner(request.resource.data, request.auth.uid)
      )) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'uid', 'user_id']);
    }

    // Favorites Collection (Strict Ownership with Multi-Field Consistency Check)
    match /favorites/{favId} {
      allow read, delete: if isAuthenticated() && (isStrictOwner(resource.data, request.auth.uid) || isAdmin());
      allow create: if isAuthenticated() && isStrictOwner(request.resource.data, request.auth.uid);
      allow update: if (isAdmin() || (
        isAuthenticated() &&
        isStrictOwner(resource.data, request.auth.uid) &&
        isStrictOwner(request.resource.data, request.auth.uid)
      )) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'uid', 'user_id']);
    }

    // User Wishlists (Owner only; immutable ownership keys for owner and admin)
    match /wishlists/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('user_id' in request.resource.data) || request.resource.data.user_id == userId)
      ) || isAdmin();
      allow update: if (isOwner(userId) || isAdmin()) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('user_id' in request.resource.data) || request.resource.data.user_id == userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'uid', 'id', 'user_id']);
    }

    // Compare History (Strict Ownership with Multi-Field Consistency Check)
    match /compare_history/{historyId} {
      allow read, delete: if isAuthenticated() && (isStrictOwner(resource.data, request.auth.uid) || isAdmin());
      allow create: if isAuthenticated() && isStrictOwner(request.resource.data, request.auth.uid);
      allow update: if (isAdmin() || (
        isAuthenticated() &&
        isStrictOwner(resource.data, request.auth.uid) &&
        isStrictOwner(request.resource.data, request.auth.uid)
      )) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'uid', 'user_id']);
    }

    // Compare Logs (Admin Read/Write Only)
    match /compare_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Chat History (Owner or Admin only; immutable ownership keys)
    match /chat_history/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && (!('user_id' in request.resource.data) || request.resource.data.user_id == userId)) || isAdmin();
      allow update: if (isOwner(userId) || isAdmin()) &&
        (!('user_id' in request.resource.data) || request.resource.data.user_id == userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_id', 'userId', 'uid', 'id']);
    }
    match /chatbot_history/{historyId} {
      allow read, write: if isAdmin();
    }

    // Search Logs (Public/User Write-Only Event Logging with Schema & Bound Checks, Admin Read/Manage Only)
    match /search_logs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['query', 'user_email', 'timestamp', 'details']) &&
        request.resource.data.query is string && request.resource.data.query.size() <= 250 &&
        (!('user_email' in request.resource.data) || request.resource.data.user_email == 'Guest' || (isAuthenticated() && request.auth.token.email == request.resource.data.user_email));
      allow read, update, delete: if isAdmin();
    }

    // Analytics (Admin Read/Write Only)
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // Import History (Admin Read/Write Only)
    match /import_history/{importId} {
      allow read, write: if isAdmin();
    }

    // Activity Logs (Write-Only Event Logging with Strict Type Whitelist & Size Bounds, Admin Read/Manage Only)
    match /activity_logs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'text', 'user_email', 'timestamp', 'details']) &&
        request.resource.data.type is string &&
        request.resource.data.text is string && request.resource.data.text.size() <= 300 &&
        (
          (request.resource.data.type in ['registration', 'profile_update', 'favorite', 'compare', 'search', 'chatbot', 'contact', 'card_view']) ||
          isAdmin()
        ) &&
        (!('user_email' in request.resource.data) || request.resource.data.user_email == 'Guest' || (isAuthenticated() && request.auth.token.email == request.resource.data.user_email) || isAdmin());
      allow read, update, delete: if isAdmin();
    }

    // Referral Clicks (Public Outlink Logging with Schema & Size Bounds, Admin Read/Manage Only)
    match /referral_clicks/{clickId} {
      allow create: if request.resource.data.keys().hasOnly([
        'referralCode', 'userId', 'user_id', 'timestamp', 'source', 'page',
        'card_id', 'card_name', 'bank_name', 'clicked_url', 'clicked_at'
      ]) &&
      request.resource.data.referralCode is string && request.resource.data.referralCode.size() <= 100 &&
      request.resource.data.source is string && request.resource.data.source.size() <= 150 &&
      (!('userId' in request.resource.data) || request.resource.data.userId == null || (isAuthenticated() && request.resource.data.userId == request.auth.uid)) &&
      (!('user_id' in request.resource.data) || request.resource.data.user_id == null || (isAuthenticated() && request.resource.data.user_id == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }

    // Admin DB & Admin Users Collections (Admin Only with Verified Primary Bootstrap Exception)
    match /admins/{adminId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == adminId &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'ritikanshu072@gmail.com' &&
        request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'active', 'createdAt', 'created_at']) &&
        request.resource.data.uid == adminId &&
        request.resource.data.email.lower() == 'ritikanshu072@gmail.com' &&
        request.resource.data.role == 'admin' &&
        request.resource.data.active == true
      );
    }
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
