rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'ritikanshu072@gmail.com') ||
         (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin') ||
         (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin') ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Debit Cards Collection (Public Read, Admin Write Only)
    match /debit_cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banks Collection (Public Read, Admin Write Only)
    match /banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQ Collection (Public Read, Admin Write Only)
    match /faq/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers Collection (Public Read, Admin Write Only)
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles (Owner or Admin can read/write)
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Users Collection (Owner or Admin can read/write)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Contact Queries & Messages Collection (Admin Read/Manage Only)
    match /contact_queries/{queryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Favorites / Saved Cards / Wishlists
    match /saved_cards/{savedId} {
      allow read, write: if isAuthenticated();
    }
    match /favorites/{favId} {
      allow read, write: if isAuthenticated();
    }
    match /wishlists/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Compare History & Compare Logs
    match /compare_history/{historyId} {
      allow read, write: if isAuthenticated();
    }
    match /compare_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Chatbot History & Chat History
    match /chat_history/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /chatbot_history/{historyId} {
      allow read, write: if isAdmin();
    }

    // Search Logs (Admin Read/Write Only)
    match /search_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Analytics (Admin Read/Write Only)
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // Import History (Admin Read/Write Only)
    match /import_history/{importId} {
      allow read, write: if isAdmin();
    }

    // Activity Logs (Admin Read/Write Only)
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Referral Clicks
    match /referral_clicks/{clickId} {
      allow read, write: if isAuthenticated();
    }

    // Admin DB & Admin Users Collections (Admin Only)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /admin_users/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
