{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/banks-near-you",
      "destination": "/find-my-bank",
      "permanent": true
    },
    {
      "source": "/find-banks",
      "destination": "/find-my-bank",
      "permanent": true
    },
    {
      "source": "/debit-cards",
      "destination": "/cards",
      "permanent": true
    },
    {
      "source": "/savings",
      "destination": "/savings-accounts",
      "permanent": true
    },
    {
      "source": "/current",
      "destination": "/current-accounts",
      "permanent": true
    },
    {
      "source": "/current-account",
      "destination": "/current-accounts",
      "permanent": true
    },
    {
      "source": "/favorites",
      "destination": "/saved-cards",
      "permanent": true
    },
    {
      "source": "/founders",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ai-assistance",
      "destination": "/ai-advisor",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
